# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.
#
# Supabase (needed from Milestone 3 for real sign-in and saved data).
# Find both values in your Supabase dashboard → Project Settings → API.
# The anon key is designed to be public: row-level security protects the data.
# NEVER put the service_role key in this file or anywhere in frontend code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# When "true", the app runs on the in-browser demo backend with fictional data,
# even if Supabase values are present. Defaults to demo mode when Supabase is not configured.
VITE_DEMO_MODE=true
